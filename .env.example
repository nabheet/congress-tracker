# Copy to .env and adjust. The script loads .env if present; real env vars
# always win. Never commit .env.

# Postgres connection
PG_HOST=localhost
PG_PORT=5432
PG_DB=congress
PG_USER=postgres

# File containing the DB password (required; docker secrets default)
POSTGRES_PASSWORD_FILE=/path/to/password-file

# Source endpoints (defaults match the public congressional sites)
SENATE_BASE=https://efdsearch.senate.gov
HOUSE_SITE=https://disclosures-clerk.house.gov
HOUSE_PUBLIC=https://disclosures-clerk.house.gov/public_disc

# Senate pull window (days, when no explicit START_DATE/END_DATE)
DAYS_BACK=30

# Optional explicit range (overrides DAYS_BACK; Senate only)
# START_DATE=2026-01-01
# END_DATE=2026-12-31

# Directory of .sql migration files
# MIGRATIONS_DIR=migrations